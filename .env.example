# Copia este archivo a `.env` y rellena los valores.
#
#   cp .env.example .env
#
# El archivo `.env` está ignorado por git: nunca subas claves reales.

# Clave de cliente de AcoustID (obligatoria para la identificación por huella).
# Sin ella el motor omite la consulta a AcoustID y solo usa fuentes textuales.
# Consigue una gratis en https://acoustid.org/new-application
VITE_ACOUSTID_CLIENT=

# User-Agent que se envía a MusicBrainz (requieren identificar la aplicación).
VITE_MUSICBRAINZ_USER_AGENT=Calliope/2.1.0 (local music player)

# Proveedor acústico opcional / proxy (desactivado por defecto).
VITE_AUDIO_IDENTIFICATION_PROXY_ENABLED=false
VITE_AUDIO_IDENTIFICATION_PROXY_URL=

# Proxy opcional para Deezer (evita el bloqueo por CORS en el navegador).
VITE_DEEZER_PROXY_URL=

# Client ID público OAuth de Google (no es un secreto).
# La autorización de Drive se ejecuta en el navegador; nunca añadas un client_secret.
VITE_GOOGLE_CLIENT_ID=557390540653-9ee5rgns61guh0fkdfvqgege4f0hk04n.apps.googleusercontent.com